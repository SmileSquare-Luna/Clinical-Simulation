  m_EditorClassIdentifier: 
  AskActionList:
  - AskIndex: 0
    AskActionQuestion: You find someone collapsed on the ground. What should be your
      first step as a rescuer?
    AskActionOptionA: Verify scene safety
    AskActionOptionB: Kneel down beside stranger
  - AskIndex: 0
    AskActionQuestion: You have ensured scene safety and kneeled beside the victim.
      What should you do next?
    AskActionOptionA: Tap victim's shoulder
    AskActionOptionB: Call 811
  - AskIndex: 0
    AskActionQuestion: You have kneeled beside the victim. What should you do next?
    AskActionOptionA: Tap victim's shoulder
    AskActionOptionB: Call 811
  - AskIndex: 0
    AskActionQuestion: The victim is unresponsive. What should you do next?
    AskActionOptionA: Call 811
    AskActionOptionB: Check carotid pulse
  - AskIndex: 0
    AskActionQuestion: Emergency services have been called. What should you do next?
    AskActionOptionA: Check carotid pulse
    AskActionOptionB: Start CPR
  - AskIndex: 0
    AskActionQuestion: You check the carotid pulse and find that the victim has no
      pulse. What should you do next?
    AskActionOptionA: Start CPR
    AskActionOptionB: Wait for 811 to arrive
  selectedAction: 
  currentActionIndex: 0
